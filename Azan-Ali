    <div class="container">
      <div class="projects-header">
        <h2 class="section-title">Projects Showcase</h2>
        <div class="filter-tabs" id="filterTabs">
          <button class="tab active" data-category="all">All (635+)</button>
          <button class="tab" data-category="hero">Hero Sections (150+)</button>
          <button class="tab" data-category="dashboard">Dashboards (90+)</button>
          <button class="tab" data-category="mobile">Mobile Apps (120+)</button>
          <button class="tab" data-category="banner">Banners (200+)</button>
          <button class="tab" data-category="wireframe">Wireframes (75+)</button>
        </div>
      </div>

      <div class="projects-grid" id="projectsGrid">
        <!-- Projects populated via JS / Supabase -->
      </div>
    </div>
  </section>

  <!-- Case Studies & How I Work -->
  <section id="casestudies" class="casestudies-section">
    <div class="container">
      <h2 class="section-title">How I Work (4-Step UX Process)</h2>
      <div class="skills-grid">
        <div class="skill-card"><h3>1. Discover & Research</h3><p>Understanding problem statements, user needs, and competitive market benchmarking.</p></div>
        <div class="skill-card"><h3>2. Wireframe & Structure</h3><p>Building structural low-fidelity blueprints and mapping friction-free user flows.</p></div>
        <div class="skill-card"><h3>3. Visual Design</h3><p>Crafting high-fidelity UI with design systems, auto-layout, and color psychology.</p></div>
        <div class="skill-card"><h3>4. Prototype & Test</h3><p>Building clickable Figma prototypes to validate interactions before handover.</p></div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="contact-section">
    <div class="container contact-grid">
      <div class="contact-info">
        <h2>Let's Build Something Great Together</h2>
        <p>Direct inquiries, agency collaborations, or freelance projects.</p>
        <ul class="contact-list">
          <li><strong>Email:</strong> azanmoneymaker@gmail.com</li>
          <li><strong>Phone / WhatsApp:</strong> <a href="https://wa.me/923554051652" target="_blank" style="color:var(--secondary-accent);">+92 355-4051652</a></li>
          <li><strong>Location:</strong> Gilgit, Pakistan</li>
          <li><strong>Behance:</strong> <a href="https://www.behance.net/azanaliad" target="_blank" style="color:var(--secondary-accent);">behance.net/azanaliad</a></li>
        </ul>
      </div>

      <form class="contact-form" id="hireForm">
        <h3>Send a Message</h3>
        <input type="text" id="clientName" placeholder="Your Full Name" required />
        <input type="email" id="clientEmail" placeholder="Your Email Address" required />
        
        <select id="projectType" required>
          <option value="" disabled selected>Select Project Type</option>
          <option value="Mobile App">Mobile App Design</option>
          <option value="Dashboard">Dashboard / Admin Panel</option>
          <option value="Hero Section">Hero Section / Web Design</option>
          <option value="Wireframes">UX Wireframing & Prototyping</option>
          <option value="Banners">Digital Ad Banners</option>
          <option value="Full Package">Full Package UI/UX</option>
        </select>

        <select id="budgetRange" required>
          <option value="" disabled selected>Select Budget Range</option>
          <option value="Under $100">Under $100</option>
          <option value="$100 - $300">$100 - $300</option>
          <option value="$300 - $800">$300 - $800</option>
          <option value="$800 - $1,500">$800 - $1,500</option>
          <option value="$1,500+">$1,500+</option>
        </select>

        <textarea id="projectMessage" rows="5" placeholder="Tell me about your project..." required></textarea>

        <button type="submit" class="btn btn-primary pulse-btn" id="submitBtn">Send Direct Inquiry</button>
      </form>
    </div>
  </section>

